# setup-local.ps1 fills local Supabase credentials in ignored .env.
# Cloud: copy to ignored .env.cloud, set hosted URLs/keys and APP_ENV=production.
APP_ENV=development
LOCAL_AUTH=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:56322/postgres
STORAGE_BACKEND=supabase
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Language learning uses a hosted quality candidate, never the local chat fallback.
# Server only: use scripts/configure-openai.ps1; do not put keys in VITE_* variables.
OPENAI_API_KEY=
LANGUAGE_DAILY_BUDGET_USD=2
LANGUAGE_DAILY_TURN_LIMIT=100
HOSTED_CHAT_TIMEOUT_SECONDS=120
HTTP_MODEL_BASE_URL=http://127.0.0.1:8188
LOCAL_MEDIA_CAPABILITIES=text_to_image
# Optional broader web search; blank keeps the free Wikipedia lookup.
# Configure only with explicit Brave storage rights: Powwow persists source context.
# Paid plans/free credits alone do not establish that entitlement. Backend only.
BRAVE_API_KEY=
MAX_RUN_BUDGET_USD=1
# Only honored with APP_ENV=development. Usage and uncertain-submission records remain active.
DEVELOPMENT_UNCAPPED_SPENDING=false
# Quality-first image candidate; this reserves allowance and never raises the request cap.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
OPENAI_IMAGE_RESERVATION_USD=1
ACCOUNT_BUDGET_USD=10
# Paid deployments: set rates to the selected endpoint's current console quote.
RUNPOD_HOURLY_RATE_USD=1.75
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=artifacts
# Local GPU signed-output uploads only. Cloud workers require HTTPS and the
# exact hosted Supabase hostname, with POWWOW_ALLOW_LOCAL_STORAGE_HTTP=0.
POWWOW_UPLOAD_HOSTS=127.0.0.1,localhost
POWWOW_ALLOW_LOCAL_STORAGE_HTTP=1
POWWOW_TRELLIS_LOCAL_ROOT=
BLENDER_BINARY=
POWWOW_BLENDER_SCRIPT=
POWWOW_TRELLIS_RUNS_DIR=
RUNPOD_API_KEY=
RUNPOD_IMAGE_ENDPOINT_ID=
RUNPOD_VIDEO_ENDPOINT_ID=
RUNPOD_3D_ENDPOINT_ID=
RUNPOD_CHAT_ENDPOINT_ID=
