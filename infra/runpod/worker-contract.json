{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Powwow trusted media worker input v1",
  "type": "object",
  "required": ["capability", "prompt"],
  "properties": {
    "capability": {"enum": ["chat", "text_to_image", "image_to_video", "image_to_3d"]},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 8000},
    "settings": {"type": "object"},
    "messages": {"type": "array", "maxItems": 64, "items": {"type": "object", "required": ["role", "content"], "properties": {"role": {"enum": ["system", "user", "assistant"]}, "content": {"type": "string"}}}},
    "source_image": {
      "type": "object", "required": ["base64", "mime_type"],
      "properties": {"base64": {"type": "string"}, "mime_type": {"enum": ["image/png", "image/jpeg", "image/webp"]}}
    },
    "output_upload": {
      "description": "Allocated by API, never accepted as an arbitrary client destination. Worker must allowlist exact HTTPS hostname.",
      "type": "object", "required": ["url", "storage_key"],
      "properties": {"url": {"type": "string", "format": "uri"}, "method": {"enum": ["PUT", "POST"]}, "headers": {"type": "object"}, "storage_key": {"type": "string"}}
    }
  }
}
