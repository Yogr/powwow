FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-devel@sha256:0cf3402e946b7c384ba943ee05c90b4c5a4a05227923921f2b0918c011cfaf56
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 HF_HOME=/runpod-volume/huggingface \
    POWWOW_WORKER_PROFILE=video POWWOW_WAN_ROOT=/opt/Wan2.2 MAX_JOBS=4 \
    TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0"
RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg libgl1 libglib2.0-0 build-essential && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/Wan-Video/Wan2.2.git /opt/Wan2.2 && \
    cd /opt/Wan2.2 && git checkout 1ea34ff48f87168174e12956e200b1d908b1c5ff
RUN pip install --no-cache-dir packaging ninja wheel setuptools && \
    pip install --no-cache-dir flash-attn==2.7.3 --no-build-isolation
# Wan intentionally uses transformers 4.x in its isolated image.
RUN pip install --no-cache-dir torchvision==0.21.0 torchaudio==2.6.0 \
    transformers==4.51.3 diffusers==0.33.1 accelerate==1.6.0 numpy==1.26.4 \
    opencv-python-headless==4.11.0.86 easydict==1.13 ftfy==6.3.1 dashscope==1.23.1 \
    imageio==2.37.0 imageio-ffmpeg==0.6.0 Pillow==11.2.1 tqdm==4.67.1 \
    huggingface-hub==0.30.2 runpod==1.12.0 httpx==0.28.1 fastapi==0.142.2 uvicorn==0.54.0
WORKDIR /app
COPY services/gpu_worker /app
CMD ["python", "-u", "runpod_handler.py"]
